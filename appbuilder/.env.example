# Copy to .env (never commit) and fill from your Salesforce Connected App.
# Same values belong in the da.live org secrets sheet via the plugin Settings UI.

SF_INSTANCE_URL=https://YOUR_ORG.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_TOKEN_URL=https://YOUR_ORG.my.salesforce.com/services/oauth2/token
SF_REFRESH_TOKEN=
SF_SCOPE=api chatter_api full id openid refresh_token visualforce web
